<!--
  PSCyber Sysmon configuration - real-time registry, file and process telemetry for the SOC.
  Focused on what attackers change, not everything: the registry keys used for persistence,
  privilege escalation and turning security off; files dropped where Windows runs them
  automatically; and every process start (Wazuh's rules pick out the suspicious ones).
  Each registry entry below is a MITRE ATT&CK technique the SOC watches for.
  Since 2026-10-26 also the narrow telemetry Wazuh's OWN Sysmon rules need (they ship with the manager -
  see integrations/wazuh/stock_sysmon_rules.txt): access to LSASS / explorer / the RDP client, remote
  threads, PowerShell and admin-protocol connections, a few module loads, and WMI subscriptions.
-->
<Sysmon schemaversion="4.50">
  <HashAlgorithms>sha256</HashAlgorithms>
  <CheckRevocation>false</CheckRevocation>
  <EventFiltering>

    <!-- Event 1: process creation. The Wazuh agent's own processes are left out. -->
    <RuleGroup name="" groupRelation="or">
      <ProcessCreate onmatch="exclude">
        <Image condition="begin with">C:\Program Files (x86)\ossec-agent\</Image>
        <ParentImage condition="begin with">C:\Program Files (x86)\ossec-agent\</ParentImage>
      </ProcessCreate>
    </RuleGroup>

    <!-- Events 12/13/14: registry key/value created, set, deleted or renamed - attacker keys only. -->
    <RuleGroup name="" groupRelation="or">
      <RegistryEvent onmatch="include">
        <TargetObject name="T1547.001 Run keys" condition="contains">\CurrentVersion\Run</TargetObject>
        <TargetObject name="T1547.001 Policies Run" condition="contains">\Policies\Explorer\Run</TargetObject>
        <TargetObject name="T1547.004 Winlogon" condition="contains">\Microsoft\Windows NT\CurrentVersion\Winlogon</TargetObject>
        <TargetObject name="T1546.012 IFEO" condition="contains">\Image File Execution Options\</TargetObject>
        <TargetObject name="T1546.010 AppInit DLLs" condition="contains">\Windows\AppInit_DLLs</TargetObject>
        <TargetObject name="T1546.015 COM hijack" condition="contains">\Software\Classes\CLSID\</TargetObject>
        <TargetObject name="T1543.003 Services" condition="begin with">HKLM\System\CurrentControlSet\Services\</TargetObject>
        <TargetObject name="T1547.005 LSA packages" condition="contains">\Control\Lsa\</TargetObject>
        <TargetObject name="T1112 Credential caching" condition="contains">\Control\SecurityProviders\WDigest</TargetObject>
        <TargetObject name="T1562.001 Defender off" condition="contains">\Policies\Microsoft\Windows Defender</TargetObject>
        <TargetObject name="T1562.001 Defender settings" condition="contains">\Microsoft\Windows Defender\</TargetObject>
        <TargetObject name="T1562.004 Firewall" condition="contains">\Services\SharedAccess\Parameters\FirewallPolicy</TargetObject>
        <TargetObject name="T1053.005 Scheduled tasks" condition="contains">\Schedule\TaskCache\</TargetObject>
        <TargetObject name="T1546.011 Shim databases" condition="contains">\AppCompatFlags\Custom</TargetObject>
        <TargetObject name="T1548.002 UAC bypass" condition="contains">\shell\open\command</TargetObject>
        <TargetObject name="T1548.002 UAC policy" condition="contains">\Policies\System\EnableLUA</TargetObject>
        <TargetObject name="T1021.001 RDP" condition="contains">\Control\Terminal Server\</TargetObject>
        <TargetObject name="T1137 Office startup" condition="contains">\Microsoft\Office\</TargetObject>
        <TargetObject name="T1547.002 Authentication packages" condition="contains">\Control\Session Manager\</TargetObject>
      </RegistryEvent>
    </RuleGroup>
    <!-- ...but not the services Windows itself rewrites all day (seen on a live DC: BITS, W32Time).
         NOT svchost.exe as a whole (the Task Scheduler runs in it - that would hide task persistence)
         and NOT every service's Start value (attackers set Defender's to 4 = disabled). -->
    <RuleGroup name="" groupRelation="or">
      <RegistryEvent onmatch="exclude">
        <TargetObject condition="contains">\Services\bam\State\</TargetObject>
        <TargetObject condition="contains">\Services\W32Time\</TargetObject>
        <TargetObject condition="contains">\Services\BITS\</TargetObject>
        <TargetObject condition="contains">\Services\wuauserv\</TargetObject>
        <TargetObject condition="contains">\Services\UsoSvc\</TargetObject>
        <TargetObject condition="contains">\Services\TrustedInstaller\</TargetObject>
        <TargetObject condition="contains">\Services\Tcpip\Parameters\Interfaces\</TargetObject>
        <TargetObject condition="contains">\Services\Dnscache\Parameters\</TargetObject>
        <TargetObject condition="contains">\Services\Tcpip\Parameters</TargetObject>
        <Image condition="begin with">C:\Program Files (x86)\ossec-agent\</Image>
        <!-- Defender's own engine writes its own settings every few seconds (seen live). An attacker
             turning Defender off writes from ANOTHER program, under \Policies\ - still recorded. -->
        <Image condition="end with">\MsMpEng.exe</Image>
        <Image condition="end with">\MpCmdRun.exe</Image>
      </RegistryEvent>
    </RuleGroup>

    <!-- Event 11: files created where Windows runs them automatically. -->
    <RuleGroup name="" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename name="T1547.001 Startup folder" condition="contains">\Start Menu\Programs\Startup\</TargetFilename>
        <TargetFilename name="T1053.005 Task file" condition="begin with">C:\Windows\System32\Tasks\</TargetFilename>
        <TargetFilename name="T1505.003 Web shell" condition="begin with">C:\inetpub\wwwroot\</TargetFilename>
      </FileCreate>
    </RuleGroup>

    <!-- ===== Telemetry for Wazuh's OWN Sysmon rules (ruleset 0810/0820/0870/0945/0950 on the manager).
         Each block records only what those rules look at, so volume stays small. 2026-10-26. ===== -->

    <!-- Event 10: process access - ONLY to the processes Wazuh's rules watch (92900 LSASS read access,
         92910 explorer, 92920 the RDP client). Query-only access rights are left out: they cannot read memory
         and are what Windows itself does all day. -->
    <RuleGroup name="" groupRelation="or">
      <ProcessAccess onmatch="include">
        <TargetImage condition="end with">\lsass.exe</TargetImage>
        <TargetImage condition="end with">\explorer.exe</TargetImage>
        <TargetImage condition="end with">\mstsc.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <ProcessAccess onmatch="exclude">
        <GrantedAccess condition="is any">0x1000;0x1400;0x100000;0x101000;0x2000;0x3000</GrantedAccess>
        <SourceImage condition="begin with">C:\Program Files (x86)\ossec-agent\</SourceImage>
        <SourceImage condition="end with">\MsMpEng.exe</SourceImage>
        <!-- Windows licensing service copying a handle from Explorer every 15 min (0x40 = duplicate a handle,
             cannot read memory) - seen on the lab DC; would otherwise match 92910 (L12) on every machine -->
        <Rule groupRelation="and">
          <SourceImage condition="end with">\System32\sppsvc.exe</SourceImage>
          <TargetImage condition="end with">\explorer.exe</TargetImage>
          <GrantedAccess condition="is">0x40</GrantedAccess>
        </Rule>
      </ProcessAccess>
    </RuleGroup>

    <!-- Event 8: one process starting a thread inside another (92400-92403). Rare in normal work. -->
    <RuleGroup name="" groupRelation="or">
      <CreateRemoteThread onmatch="exclude">
        <SourceImage condition="begin with">C:\Program Files (x86)\ossec-agent\</SourceImage>
      </CreateRemoteThread>
    </RuleGroup>

    <!-- Event 3: network connections - only those 0810's rules read: made BY PowerShell, and OUTGOING to
         SMB / RPC / RDP / WinRM (92102-92110). Not every connection the machine makes. -->
    <RuleGroup name="" groupRelation="or">
      <NetworkConnect onmatch="include">
        <Image condition="end with">\powershell.exe</Image>
        <Image condition="end with">\pwsh.exe</Image>
        <Rule groupRelation="and">
          <Initiated condition="is">true</Initiated>
          <DestinationPort condition="is any">135;445;3389;5985;5986</DestinationPort>
        </Rule>
      </NetworkConnect>
    </RuleGroup>
    <!-- ...but not our own device-health reporter (PowerShell -> the site collector on TCP 1520 every 30 s):
         117 of 150 network events an hour on the lab DC -->
    <RuleGroup name="" groupRelation="or">
      <NetworkConnect onmatch="exclude">
        <Rule groupRelation="and">
          <Image condition="end with">\powershell.exe</Image>
          <DestinationPort condition="is">1520</DestinationPort>
        </Rule>
      </NetworkConnect>
    </RuleGroup>

    <!-- Event 7: module loads - only the modules 0820's rules name (92151-92157). -->
    <RuleGroup name="" groupRelation="or">
      <ImageLoad onmatch="include">
        <ImageLoaded condition="end with">\System.Management.Automation.dll</ImageLoaded>
        <ImageLoaded condition="end with">\System.Management.Automation.ni.dll</ImageLoaded>
        <ImageLoaded condition="end with">\vaultcli.dll</ImageLoaded>
        <ImageLoaded condition="end with">\taskschd.dll</ImageLoaded>
        <ImageLoaded condition="end with">\vbeui.dll</ImageLoaded>
        <Image condition="end with">\spoolsv.exe</Image>
        <ImageLoaded condition="contains">\AppData\Local\Temp\</ImageLoaded>
      </ImageLoad>
    </RuleGroup>

    <!-- Events 19-21: WMI event subscriptions (89501/89502). A handful a year on a normal machine. -->
    <RuleGroup name="" groupRelation="or"><WmiEvent onmatch="exclude"/></RuleGroup>

    <!-- Still off: the rest would only add volume. -->
    <RuleGroup name="" groupRelation="or"><FileCreateTime onmatch="include"/></RuleGroup>
    <RuleGroup name="" groupRelation="or"><RawAccessRead onmatch="include"/></RuleGroup>
    <RuleGroup name="" groupRelation="or"><PipeEvent onmatch="include"/></RuleGroup>
    <RuleGroup name="" groupRelation="or"><DnsQuery onmatch="include"/></RuleGroup>
    <RuleGroup name="" groupRelation="or"><FileDelete onmatch="include"/></RuleGroup>
  </EventFiltering>
</Sysmon>
